# Choose any model supported by ReqLLM.
PHIAL_MODEL=openai:gpt-5-mini
OPENAI_BASE_URL=http://localhost:8000/v1

# Set only the key required by the selected provider.
OPENAI_API_KEY=local
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Long-running ReAct actions may need more than Jido.Action's 30s default.
PHIAL_ACTION_TIMEOUT_MS=300000
